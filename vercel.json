{
  "version": 2,
  "builds": [
    {
      "src": "api/sync.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/sync",
      "dest": "api/sync.py",
      "methods": ["POST", "GET"]
    }
  ],
  "crons": [
    {
      "path": "/api/sync",
      "schedule": "0 3 * * *"
    }
  ]
}
